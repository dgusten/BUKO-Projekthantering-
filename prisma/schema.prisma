// BUKO Sverige ärendehantering — databasschema
// Speglar datamodellen från den statiska prototypen (buko-hemsida/app.js) rakt av,
// plus de senaste tilläggen: jobbnummer och koppling mellan ärenden (etapper/faser).
//
// Databas: Supabase Postgres. directUrl används bara av `prisma migrate` (måste
// gå via den icke-poolade session-porten 5432 - PgBouncer i transaction-läge på
// DATABASE_URL stödjer inte de prepared statements migreringar behöver).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  PL
  TA
}

enum CaseStatus {
  NY
  HOS_TA
  TA_KLAR
  TILLSTAND_SOKT
  TILLSTAND_AVSLAG
  TILLSTAND_BEVILJAT
  AVSLUTAT
}

enum Severity {
  LATT
  MEDEL
  SVAR
}

enum Region {
  NORD
  MITT
  EAST
  VAST
  SYD
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String? @unique
  role     Role
  initials String

  createdCases   Case[]          @relation("CreatedBy")
  assignedCases  Case[]          @relation("AssignedTo")
  comments       Comment[]
  historyEntries HistoryEntry[]
  uploadedFiles  FileAttachment[]
  timeEntries    TimeEntry[]

  createdAt DateTime @default(now())
}

model Case {
  // Behåller samma läsbara format som prototypen, t.ex. "BUKO-1009".
  id String @id

  titel          String
  kund           String
  jobbnummer     String?
  adress         String
  region         Region?
  beskrivning    String
  svarighetsgrad Severity   @default(MEDEL)
  deadline       DateTime?
  status         CaseStatus @default(NY)
  karta          String? // GeoJSON, sparas som text
  fakturerat     Boolean    @default(false)

  skapadAv   User   @relation("CreatedBy", fields: [skapadAvId], references: [id])
  skapadAvId String

  tilldeladTA   User?   @relation("AssignedTo", fields: [tilldeladTAId], references: [id])
  tilldeladTAId String?

  skapad     DateTime @default(now())
  uppdaterad DateTime @updatedAt

  comments       Comment[]
  files          FileAttachment[]
  historyEntries HistoryEntry[]
  statusLog      StatusLogEntry[]
  tillstand      Tillstand?
  timeEntries    TimeEntry[]

  // Koppling mellan ärenden (etapper/faser av samma projekt).
  linksFrom CaseLink[] @relation("LinkFrom")
  linksTo   CaseLink[] @relation("LinkTo")

  @@index([skapadAvId])
  @@index([tilldeladTAId])
  @@index([status])
}

// En rad per riktning så en koppling alltid är sökbar från båda ärendena
// utan en extra join-fråga. linkCase()/unlinkCase() i API:t skriver båda raderna
// samtidigt, precis som prototypens bidirektionella lankadeArenden-lista.
model CaseLink {
  id String @id @default(cuid())

  case   Case   @relation("LinkFrom", fields: [caseId], references: [id], onDelete: Cascade)
  caseId String

  linked   Case   @relation("LinkTo", fields: [linkedId], references: [id], onDelete: Cascade)
  linkedId String

  @@unique([caseId, linkedId])
}

model Comment {
  id    String   @id @default(cuid())
  text  String
  datum DateTime @default(now())

  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@index([caseId])
}

model FileAttachment {
  id      String   @id @default(cuid())
  namn    String
  storlek Int
  typ     String
  // Riktig lagring (Supabase Storage) istället för base64 i localStorage.
  url     String
  datum   DateTime @default(now())

  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String

  uppladdadAv   User   @relation(fields: [uppladdadAvId], references: [id])
  uppladdadAvId String

  @@index([caseId])
}

model HistoryEntry {
  id    String   @id @default(cuid())
  text  String
  datum DateTime @default(now())

  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  @@index([caseId])
}

// Motsvarar prototypens statusLog[] — en rad per statusövergång, används för att
// räkna ut ritningstid per TA-plansritare på statistiksidan.
model StatusLogEntry {
  id     String     @id @default(cuid())
  status CaseStatus
  datum  DateTime   @default(now())

  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String

  @@index([caseId])
}

// Timregistrering - TA-plansritaren kan logga timmar flera gånger på samma
// ärende (t.ex. en rad per revideringsrunda när PL skickar tillbaka jobbet).
model TimeEntry {
  id        String   @id @default(cuid())
  timmar    Float
  kommentar String?
  datum     DateTime @default(now())

  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@index([caseId])
}

model Tillstand {
  id String @id @default(cuid())

  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId String @unique

  startdatum           DateTime?
  slutdatum            DateTime
  kundKontaktNamn      String?
  kundKontaktEmail     String?
  paminnelseDagarInnan Int       @default(14)
}
